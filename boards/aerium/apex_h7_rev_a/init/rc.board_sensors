#!/bin/sh
#
# aerium Apex h7 specific board sensors init
#------------------------------------------------------------------------------

board_adc start

# ICM-42688-P on SPI2
icm42688p -R 0 -s start

# ICM-45686 on SPI1 (fitted on the U19 footprint drawn as BMI270 in the schematic)
icm45686 -R 0 -s start

# DPS368 baro on SPI1
dps310 -s start

# Onboard LIS3MDL on I2C2 (0x1E). I2C2 is an external bus because it also goes
# to the GPS2 connector; i2c.cpp reports this one device as internal.
lis3mdl -X -b 2 -R 14 start
