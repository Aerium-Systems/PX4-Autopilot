#!/bin/sh
#
# aerium Apex h7 specific board sensors init
#------------------------------------------------------------------------------

board_adc start

# ICM-45686 replaces BMI270 on the same footprint/CS/DRDY pins (SPI1)
icm42688p -R 0 -s start
icm45686 -R 0 -s start

dps310 -s start

lis3mdl -I -b 2 -R 14 start
