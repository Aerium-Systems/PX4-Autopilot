#!/bin/sh
#
# board sensors init
#
# Both sensors are published to CAN by uavcannode (started by the cannode rcS):
#   GNSS -> uavcan.equipment.gnss.Fix2 + uavcan.equipment.gnss.Auxiliary
#   mag  -> uavcan.equipment.ahrs.MagneticFieldStrength2
#------------------------------------------------------------------------------

# u-blox NEO-M9N: GPS_TXD -> USART1_RX (PB3), USART1_TX (PA15) -> GPS_RXD.
# USART1 is /dev/ttyS0 (CONFIG_STM32_SERIAL_DISABLE_REORDERING keeps USART order).
gps start -d /dev/ttyS0 -p ubx

# ST LIS3MDL magnetometer on I2C1 (PB6/PB7), SA1 tied high -> address 0x1E.
lis3mdl -I -b 1 start
